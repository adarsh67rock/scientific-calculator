from tkinter import *
import math
first_num=second_num=operator=None
def digit_display(number):
    current=result["text"]
    new=current+str(number)
    result.configure(text=new)

def clear():
    result.configure(text="")

def operat(op):
    global first_num,second_num,operator
    first_num=float(result["text"])
    operator=op
    result.config(text="")

def equal():
    global first_num,second_num,operator
    if result["text"]=='':
        second_num=0
    else:
        second_num=float(result["text"])
    if operator=="+":
        result.config(text=str(first_num+second_num))
    elif operator=="-":
        result.config(text=str(first_num-second_num))
    elif operator=="*":
        result.config(text=str(first_num*second_num))
    elif operator=="√":
        result.config(text=str(math.sqrt(first_num)))
    elif operator=="1/n":
        result.config(text=str(1/first_num))
    elif operator=="/":
        if second_num==0:
            result.config(text="error")
        else:
            result.config(text=str(first_num/second_num))
    elif operator=="%":
        if second_num==0:
            result.config(text="error")
        else:
            result.config(text=str(first_num % second_num))
    elif operator=="x²":
        result.config(text=str(first_num**2))
    elif operator=="eⁿ":
        result.config(text=str(2.718**first_num))
    elif operator=="xʸ":
        result.config(text=str(first_num**second_num))
    elif operator=="log":
        result.config(text=str(math.log10(first_num)))
    elif operator=="ln":
        result.config(text=str(math.log(first_num)))
    elif operator=="sin-1":
        result.config(text=str(math.degrees(math.asin(first_num))))
    elif operator=="cos-1":
        result.config(text=str(math.degrees(math.acos(first_num))))
    elif operator=="tan-1":
        result.config(text=str(math.degrees(math.atan(first_num))))
    elif operator=="sin":
        result.config(text=str(math.sin(math.radians(first_num))))
    elif operator=="cos":
        result.config(text=str(math.cos(math.radians(first_num))))
    elif operator=="tan":
        result.config(text=str(math.tan(math.radians(first_num))))

                      
        
        
    
